# WeEverything Environment Configuration
# Copy this file to .env and fill in values

# Application
NODE_ENV=development
APP_NAME=WeEverything
APP_URL=http://localhost:3000

# API
API_PORT=4000
API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://weeverything:changeme@localhost:5432/weeverything_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# MinIO / S3 Storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=weeverything
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASS=changeme
SMTP_FROM="WeEverything <noreply@example.com>"

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# Cookie
COOKIE_SECRET=change-me-cookie-secret-min-32-chars
COOKIE_DOMAIN=localhost

# Connected Apps / OAuth Integrations
# Google Workspace (Gmail / Calendar)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# YouTube API
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# Instagram API (Meta)
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_REDIRECT_URI=http://localhost:4000/api/v1/auth/instagram/callback

# ─── AI Platform ───────────────────────────────────────────
# Provider selection: gemini | openai | anthropic | openrouter | ollama
AI_DEFAULT_PROVIDER=gemini

# Provider API Keys (configure at least one for AI features to work)
GEMINI_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=your-openai-api-key            # optional
ANTHROPIC_API_KEY=your-anthropic-api-key      # optional
OPENROUTER_API_KEY=your-openrouter-api-key    # optional
OLLAMA_BASE_URL=http://localhost:11434         # optional — for local LLMs

# AI Platform Configuration
AI_CACHE_TTL_SECONDS=300      # Cache AI responses for 5 minutes
AI_MAX_TOKENS=2048            # Default max output tokens
AI_RATE_LIMIT_PER_MIN=60      # AI request rate limit per user
